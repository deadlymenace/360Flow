{
  "expo": {
    "name": "360Flow",
    "slug": "threesixtyflow",
    "owner": "deadlymenace",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cc2c18fc-3a1a-4554-82bb-be2545db1b0c",
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.threesixtyflow.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "360Flow uses the camera to take 16 guided photos that are stitched into a 360° panorama of the room.",
        "NSMotionUsageDescription": "360Flow uses motion sensors to guide capture, showing when to turn and when the phone is level for each of the 16 photos.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "package": "com.threesixtyflow.app",
      "permissions": [
        "CAMERA",
        "HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "360Flow uses the camera to take 16 guided photos that are stitched into a 360° panorama of the room.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "360Flow uses motion sensors to guide capture, showing when to turn and when the phone is level for each of the 16 photos."
        }
      ],
      "expo-secure-store",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "cc2c18fc-3a1a-4554-82bb-be2545db1b0c"
      }
    }
  }
}
