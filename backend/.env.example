# Copy to backend/.env for local development. Leave a variable blank to use the fallback.

# Public URL of this API, no trailing slash. Used for share links.
# Example: https://your-app.up.railway.app
PUBLIC_BASE_URL=

# Operator key for /api/v1. Compared with hmac.compare_digest. Send as X-API-Key.
# This is not an app credential. Do not put it in the mobile build.
# Leave blank to require a per-device token only.
API_KEY=

# OpenAPI docs at /docs. Leave false outside local debugging.
ENABLE_DOCS=false

# Postgres from Railway, or omit for SQLite at STORAGE_DIR/360flow.db.
# postgres:// and postgresql:// URLs are both accepted.
DATABASE_URL=

# Local files when S3/R2 is not configured. In Docker this is /data.
STORAGE_DIR=./storage

# Cloudflare R2 (S3-compatible). Set all three of bucket, access key, and secret
# to switch off local disk. S3_ENDPOINT_URL looks like:
# https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Comma-separated browser origins allowed to call the API. Empty means none.
# Do not use *.
CORS_ORIGINS=

# Gemini image editing. Blank uses a local color-grade mock.
# Default model is gemini-3.1-flash-image.
# https://ai.google.dev/gemini-api/docs/image-generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image
# 1K, 2K, or 4K
GEMINI_IMAGE_SIZE=1K

# World Labs Marble: https://docs.worldlabs.ai/api  (WLT-Api-Key)
# A fast draft world runs first (~20s) and is shown while the full model runs.
# Full worlds have taken ~10 minutes. The server polls the full model for 20 minutes.
# Set WORLDLABS_DRAFT_MODEL to off, none, false, or empty to skip the draft.
WORLDLABS_API_KEY=
WORLDLABS_DRAFT_MODEL=marble-1.0-draft
WORLDLABS_MODEL=marble-1.1
# Worlds are private unless this is true. The Marble display name is the project id.
WORLDLABS_PUBLIC=false

# Requests per minute for one device or IP, and device registrations per IP per hour.
RATE_LIMIT_PER_MINUTE=120
DEVICE_REGISTRATIONS_PER_HOUR=30
# Reject images whose header reports more pixels than this before decoding them.
MAX_IMAGE_PIXELS=24000000

# How many stitches run at once. Staging and world jobs share the same limit.
STITCH_CONCURRENCY=1
# Await jobs inside the request. Tests set this; leave it off in production.
JOBS_INLINE=false
MOCK_STAGE_DELAY=3
MOCK_WORLD_DELAY=5

MAX_IMAGE_BYTES=12582912
MIN_IMAGES=2
MAX_IMAGES=24
LOG_LEVEL=INFO
