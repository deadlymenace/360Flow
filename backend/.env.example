# Copy to backend/.env for local development. Leave a variable blank to use the fallback.

# Public URL of this API, no trailing slash. Used for share links.
# Example: https://your-app.up.railway.app
PUBLIC_BASE_URL=

# Shared secret for /api/v1. Leave blank to leave the API open (local dev only).
# Send it as the X-API-Key header. The public share pages under /v/ do not use it.
API_KEY=

# Postgres from Railway, or omit for SQLite at STORAGE_DIR/360flow.db.
# postgres:// and postgresql:// URLs are both accepted.
DATABASE_URL=

# Local files when S3/R2 is not configured. In Docker this is /data.
STORAGE_DIR=./storage

# Cloudflare R2 (S3-compatible). Set all three of bucket, access key, and secret
# to switch off local disk. S3_ENDPOINT_URL looks like:
# https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Comma-separated browser origins, or * for any origin.
CORS_ORIGINS=*

# Gemini image editing (Nano Banana). Blank uses a local color-grade mock.
# Default model is gemini-nano-banana-2.1 (Nano Banana 2.1).
# gemini-3.1-flash-image is deprecated and has no shutdown date; new work should stay on 2.1.
# https://ai.google.dev/gemini-api/docs/image-generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-nano-banana-2.1
# 1K, 2K, or 4K
GEMINI_IMAGE_SIZE=1K

# World Labs Marble: https://docs.worldlabs.ai/api  (WLT-Api-Key)
# A fast draft world runs first (~20s), then the full model (~5 min).
# Set WORLDLABS_DRAFT_MODEL to off, none, false, or empty to skip the draft.
WORLDLABS_API_KEY=
WORLDLABS_DRAFT_MODEL=marble-1.0-draft
WORLDLABS_MODEL=marble-1.1
# Worlds are created public so the Marble link can be shared.
WORLDLABS_PUBLIC=true

# How many stitches run at once. Staging and world jobs share the same limit.
STITCH_CONCURRENCY=1
# Await jobs inside the request. Tests set this; leave it off in production.
JOBS_INLINE=false
MOCK_STAGE_DELAY=3
MOCK_WORLD_DELAY=5

MAX_IMAGE_BYTES=12582912
MIN_IMAGES=2
MAX_IMAGES=24
LOG_LEVEL=INFO
