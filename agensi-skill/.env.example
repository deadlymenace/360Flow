# 360Flow Skill Environment Configuration (Bring Your Own Keys)
# Copy these variables into your shell or agent environment before running.
# Do NOT commit real keys or share them in chat.

# Required: Base URL of the 360Flow BYOK production backend (no trailing slash).
# Default buyer production server: https://agensi-prod-production.up.railway.app
FLOW360_API_URL=https://agensi-prod-production.up.railway.app

# Required for AI virtual staging (--stage): your own Google Gemini API key.
GEMINI_API_KEY=

# Required only for opt-in 3D walkthroughs (Untested Beta, when --3d is passed): your own World Labs Atlas API key.
ATLAS_API_KEY=

# Optional: Buyer access key if your configured 360Flow backend requires pre-issued keys.
FLOW360_API_KEY=

# Optional: Persisted per-session device token (auto-saved at ~/.config/flow360/device.json).
FLOW360_DEVICE_TOKEN=
